---
import { Image } from 'astro:assets';
import Button from './ui/Button.astro';
import Card from './ui/Card.astro';

export interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  subtitle: string;
  lead?: string;
  description?: string;
  benefitsTitle?: string;
  benefits: string[];
  note?: string;
  tagline?: string;
  image: ImageMetadata;
  imageAlt: string;
  ctaText: string;
  href: string;
  background?: 'white' | 'soft';
}

const {
  id,
  eyebrow = 'Producto Destacado',
  title,
  subtitle,
  lead,
  description,
  benefitsTitle,
  benefits,
  note,
  tagline,
  image,
  imageAlt,
  ctaText,
  href,
  background = 'white'
} = Astro.props;

const sectionClasses = background === 'soft'
  ? 'section-padding bg-gradient-to-br from-highlight/10 to-main/10'
  : 'section-padding bg-white';
---

<section id={id} class={sectionClasses}>
  <div class="container-custom">
    <Card class="max-w-5xl mx-auto animate-on-scroll-scale">
      <div class="grid md:grid-cols-2 gap-8 lg:gap-12 items-center">
        <!-- Texto -->
        <div>
          <span class="inline-flex items-center bg-highlight/20 text-gray-700 text-sm font-semibold rounded-full py-1.5 px-4 mb-5">
            <span class="mr-2">✨</span>
            {eyebrow}
          </span>

          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">
            {title}
          </h2>

          <p class="text-xl text-gray-600 mb-5">
            {subtitle}
          </p>

          {lead && (
            <p class="text-lg font-semibold text-gray-800 mb-3">
              {lead}
            </p>
          )}

          {description && (
            <p class="text-gray-600 leading-relaxed mb-6">
              {description}
            </p>
          )}

          {benefitsTitle && (
            <h3 class="font-semibold text-gray-900 mb-4">
              {benefitsTitle}
            </h3>
          )}

          <ul class="space-y-3 mb-6">
            {benefits.map((benefit) => (
              <li class="flex items-start space-x-3">
                <div class="w-6 h-6 bg-highlight rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                  <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                </div>
                <span class="text-gray-700">{benefit}</span>
              </li>
            ))}
          </ul>

          {note && (
            <p class="bg-highlight/10 border-l-4 border-highlight rounded-r-lg text-gray-700 text-sm leading-relaxed py-3 px-4 mb-6">
              {note}
            </p>
          )}

          <Button href={href} target="_blank" rel="noopener noreferrer">
            <span class="mr-2">🗓️</span>
            {ctaText}
          </Button>

          {tagline && (
            <p class="text-sm text-gray-500 italic mt-5">
              {tagline}
            </p>
          )}
        </div>

        <!-- Flyer -->
        <div class="relative order-first md:order-last">
          <Image
            src={image}
            alt={imageAlt}
            widths={[400, 640, 900]}
            sizes="(max-width: 768px) 90vw, 45vw"
            format="webp"
            quality={80}
            loading="lazy"
            class="w-full rounded-2xl shadow-lg"
          />

          <!-- Decorativos -->
          <div class="absolute -top-4 -right-4 w-16 h-16 bg-highlight/20 rounded-full animate-pulse-slow pointer-events-none"></div>
          <div class="absolute -bottom-4 -left-4 w-12 h-12 bg-main/30 rounded-full animate-float pointer-events-none"></div>
        </div>
      </div>
    </Card>
  </div>
</section>
