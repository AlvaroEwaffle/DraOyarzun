---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeaturedProduct from '../components/FeaturedProduct.astro';
import sculptraFlyer from '../assets/Promos/sculptra.jpeg';
import toxinaFlyer from '../assets/Promos/toxina-botulinica.png';
import Benefits from '../components/Benefits.astro';
import Testimonials from '../components/Testimonials.astro';
import Services from '../components/Services.astro';
import Offer from '../components/Offer.astro';
import Guarantee from '../components/Guarantee.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Dra. Carolina Oyarzún - Especialista en Estética Facial | Talca" 
  description="Dra. Carolina Oyarzún, especialista en estética facial en Talca. Toxina Botulínica, ácido hialurónico y tratamientos de armonización facial. 13 años de experiencia. Agenda tu asesoría gratuita."
>
  <Header />
  
  <main class="lg:pt-8">
    <Hero />

    <FeaturedProduct
      id="sculptra"
      title="Sculptra"
      subtitle="Bioestimulador de Colágeno"
      tagline="Resultados que se ven, confianza que se siente"
      benefits={[
        'Estimula la producción natural de colágeno',
        'Mejora la firmeza y elasticidad de la piel',
        'Resultados progresivos y naturales',
        'Efecto de larga duración'
      ]}
      image={sculptraFlyer}
      imageAlt="Promoción Sculptra, bioestimulador de colágeno con ácido poliláctico, en Dra. Oyarzún Talca"
      ctaText="Agenda tu evaluación"
      href="https://www.fidelidapp.cl/agendalanding/68c44056670f3153316c7f88"
      background="white"
    />

    <FeaturedProduct
      id="servicio-destacado"
      title="Toxina Botulínica"
      subtitle="Promociones vigentes"
      tagline="Resultados que se ven, confianza que se siente"
      benefits={[
        'Toxina botulínica 3 zonas con Botox® o Reage (Abbott)',
        'Opción de sumar mesoterapia Lumicen o Pink Glow',
        'Resultados naturales, sin rostro rígido',
        'Evaluación personalizada antes del procedimiento'
      ]}
      image={toxinaFlyer}
      imageAlt="Promociones de toxina botulínica: packs de 3 zonas con mesoterapia, en Dra. Oyarzún Talca"
      ctaText="Agenda tu evaluación"
      href="https://www.fidelidapp.cl/agendalanding/68c44056670f3153316c7f88"
      background="soft"
    />

    <Testimonials />
    <Benefits />
    <Services />
    <Offer />
    <Guarantee />
    <FAQ />
    <CTA />
  </main>
  
  <Footer />
</Layout>