---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import FeaturedProduct from '../components/FeaturedProduct.astro';
import sculptraFlyer from '../assets/Promos/sculptra.jpeg';
import lineasExpresionFlyer from '../assets/Promos/lineas-expresion.png';
import Benefits from '../components/Benefits.astro';
import Testimonials from '../components/Testimonials.astro';
import Services from '../components/Services.astro';
import Offer from '../components/Offer.astro';
import Guarantee from '../components/Guarantee.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Dra. Carolina Oyarzún - Especialista en Estética Facial | Talca" 
  description="Dra. Carolina Oyarzún, especialista en estética facial en Talca. Tratamiento de líneas de expresión, ácido hialurónico y tratamientos de armonización facial. 13 años de experiencia. Agenda tu asesoría gratuita."
>
  <Header />
  
  <main class="lg:pt-8">
    <Hero />

    <FeaturedProduct
      id="sculptra"
      title="Sculptra®"
      subtitle="Bioestimulador de Colágeno"
      lead="Recupera el colágeno que el tiempo ha ido perdiendo."
      description="¿Notas que tu rostro ha perdido firmeza, volumen o se ve más cansado? Sculptra® no rellena: bioestimula la producción natural de colágeno, ayudando a rejuvenecer tu piel desde el interior con resultados progresivos y naturales."
      benefitsTitle="¿Por qué elegir Sculptra®?"
      benefits={[
        'Estimula la producción natural de colágeno',
        'Mejora la firmeza y elasticidad de la piel',
        'Recupera el volumen facial de forma progresiva',
        'Rejuvenece sin cambiar tu expresión',
        'Resultados naturales y de larga duración',
        'Producto original y evaluación personalizada'
      ]}
      note="Ideal para quienes buscan un rejuvenecimiento global del rostro, con una apariencia fresca, natural y armónica."
      tagline="Resultados que se ven, confianza que se siente"
      image={sculptraFlyer}
      imageAlt="Promoción Sculptra, bioestimulador de colágeno con ácido poliláctico, en Dra. Oyarzún Talca"
      ctaText="Agenda tu evaluación"
      href="https://www.fidelidapp.cl/agendalanding/68c44056670f3153316c7f88"
      background="white"
    />

    <FeaturedProduct
      id="servicio-destacado"
      title="Líneas de expresión"
      subtitle="Promociones vigentes"
      lead="Suaviza las arrugas de expresión sin perder tu naturalidad."
      description="Relaja de forma controlada la musculatura que marca la frente, el entrecejo y las patas de gallo. El resultado es un rostro fresco y descansado, que mantiene tu expresión de siempre."
      benefitsTitle="¿Qué incluyen las promociones?"
      benefits={[
        'Líneas de expresión en 3 zonas: frente, patas de gallo y entrecejo',
        'Una sesión de mesoterapia: Lumicen o Pink Glow',
        'Evaluación personalizada antes del procedimiento',
        'Productos originales, con resultados naturales'
      ]}
      tagline="Resultados que se ven, confianza que se siente"
      image={lineasExpresionFlyer}
      imageAlt="Promoción líneas de expresión en 3 zonas con mesoterapia"
      ctaText="Agenda tu evaluación"
      href="https://www.fidelidapp.cl/agendalanding/68c44056670f3153316c7f88"
      background="soft"
    />

    <Testimonials />
    <Benefits />
    <Services />
    <Offer />
    <Guarantee />
    <FAQ />
    <CTA />
  </main>
  
  <Footer />
</Layout>